<Project>

  <!-- ======================================================
       Pragmatic .NET Code Rules - Centralized Build Settings
       Applies to ALL projects in the solution automatically.
       Course Module 05: Centralized Settings with Directory.Build.props
       ====================================================== -->

  <PropertyGroup Label="Defaults">
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Label="Code Quality">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- We generate doc XML so IDE0005 (unused usings) works - but we don't require comments -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Build Output">
    <Deterministic>true</Deterministic>
  </PropertyGroup>

</Project>
